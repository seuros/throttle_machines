{
  "plugins": [
    "cargo-workspace"
  ],
  "packages": {
    ".": {
      "release-type": "ruby",
      "package-name": "throttle_machines",
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": true
    },
    "ext/throttle_machines_native/core": {
      "release-type": "rust",
      "package-name": "throttle-machines",
      "bump-minor-pre-major": true
    },
    "ext/throttle_machines_native/ffi": {
      "release-type": "rust",
      "package-name": "throttle_machines_native",
      "bump-minor-pre-major": true
    }
  }
}
